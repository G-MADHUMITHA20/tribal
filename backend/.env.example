# MoTA TSFMS Backend Environment Configuration
# MongoDB Connection String (Atlas URI or local mongod)
MONGO_URI=mongodb+srv://username:password@cluster.mongodb.net/tsfms
MONGO_DB_NAME=tsfms

# JWT Security
JWT_SECRET=change_this_secret_to_a_secure_random_key_in_production
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# CORS
CORS_ORIGINS=http://localhost:5173
